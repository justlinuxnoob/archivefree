[Desktop Entry]
Type=Application
Name=ArchiveFree
GenericName=Archive Manager
Comment=Look inside archives before unpacking them
Keywords=zip;rar;7z;tar;gz;xz;zstd;archive;compress;extract;unzip;unpack;
Exec=archivefree %F
Icon=io.github.justlinuxnoob.ArchiveFree
Terminal=false
Categories=GTK;Utility;Archiving;Compression;
StartupNotify=true
StartupWMClass=io.github.justlinuxnoob.ArchiveFree
MimeType=application/zip;application/x-7z-compressed;application/vnd.rar;application/x-rar;application/x-rar-compressed;application/x-tar;application/gzip;application/x-gzip;application/x-compressed-tar;application/x-bzip;application/x-bzip2;application/x-bzip-compressed-tar;application/x-bzip2-compressed-tar;application/x-xz;application/x-xz-compressed-tar;application/zstd;application/x-zstd-compressed-tar;application/x-lzma;application/x-lzma-compressed-tar;application/x-lz4;application/x-lzip;application/x-cd-image;application/vnd.ms-cab-compressed;application/x-cpio;application/x-lha;application/x-lzh-compressed;application/x-archive;application/x-xar;application/x-ms-wim;application/x-apple-diskimage;application/vnd.debian.binary-package;application/x-rpm;application/x-source-rpm;application/x-compress;application/x-arj;application/x-msi;
Actions=new-archive;

[Desktop Action new-archive]
Name=New Archive…
Exec=archivefree --new-archive %F
Icon=io.github.justlinuxnoob.ArchiveFree
